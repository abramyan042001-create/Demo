digraph ER { // Направленный граф описывает реальные связи бизнес-таблиц.
rankdir=TB; // Связанные таблицы располагаются сверху вниз.
graph [bgcolor="white", pad="0.4", nodesep="0.6", ranksep="0.9"]; // Настраиваем читаемые отступы диаграммы.
node [shape=plain, fontname="DejaVu Sans", fontsize=11]; // Узлы будут таблицами с подписями полей.
portal_user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#d9eee3"><B>portal_user</B></TD></TR><TR><TD ALIGN="LEFT">id : INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">password : varchar(128)</TD></TR><TR><TD ALIGN="LEFT">last_login : datetime</TD></TR><TR><TD ALIGN="LEFT">is_superuser : bool</TD></TR><TR><TD ALIGN="LEFT">first_name : varchar(150)</TD></TR><TR><TD ALIGN="LEFT">last_name : varchar(150)</TD></TR><TR><TD ALIGN="LEFT">is_staff : bool</TD></TR><TR><TD ALIGN="LEFT">is_active : bool</TD></TR><TR><TD ALIGN="LEFT">date_joined : datetime</TD></TR><TR><TD ALIGN="LEFT">username : varchar(50)</TD></TR><TR><TD ALIGN="LEFT">full_name : varchar(150)</TD></TR><TR><TD ALIGN="LEFT">phone : varchar(16)</TD></TR><TR><TD ALIGN="LEFT">email : varchar(120)</TD></TR></TABLE>>]; // Реальные поля таблицы portal_user.
portal_course [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#d9eee3"><B>portal_course</B></TD></TR><TR><TD ALIGN="LEFT">id : INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">title : varchar(200)</TD></TR><TR><TD ALIGN="LEFT">is_active : bool</TD></TR></TABLE>>]; // Реальные поля таблицы portal_course.
portal_application [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#d9eee3"><B>portal_application</B></TD></TR><TR><TD ALIGN="LEFT">id : INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">start_date : date</TD></TR><TR><TD ALIGN="LEFT">payment_method : varchar(20)</TD></TR><TR><TD ALIGN="LEFT">status : varchar(20)</TD></TR><TR><TD ALIGN="LEFT">review_text : TEXT</TD></TR><TR><TD ALIGN="LEFT">created_at : datetime</TD></TR><TR><TD ALIGN="LEFT">user_id : bigint FK</TD></TR><TR><TD ALIGN="LEFT">course_id : bigint FK</TD></TR></TABLE>>]; // Реальные поля таблицы portal_application.
portal_course -> portal_application [label="1 : N (course_id)", fontname="DejaVu Sans", fontsize=10]; // Одна запись portal_course может иметь много заявок через course_id.
portal_user -> portal_application [label="1 : N (user_id)", fontname="DejaVu Sans", fontsize=10]; // Одна запись portal_user может иметь много заявок через user_id.
} // Завершаем граф связей бизнес-сущностей.
