digraph ER { // Схема прочитана из настоящей SQLite.
rankdir=TB; // Родительские таблицы сверху, заявки снизу.
node [shape=plain, fontname="DejaVu Sans"]; // Каждый узел отображается таблицей.
portal_user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dceee2"><B>portal_user</B></TD></TR><TR><TD ALIGN="LEFT">id : INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">password : varchar(128)</TD></TR><TR><TD ALIGN="LEFT">last_login : datetime</TD></TR><TR><TD ALIGN="LEFT">is_superuser : bool</TD></TR><TR><TD ALIGN="LEFT">first_name : varchar(150)</TD></TR><TR><TD ALIGN="LEFT">last_name : varchar(150)</TD></TR><TR><TD ALIGN="LEFT">is_staff : bool</TD></TR><TR><TD ALIGN="LEFT">is_active : bool</TD></TR><TR><TD ALIGN="LEFT">date_joined : datetime</TD></TR><TR><TD ALIGN="LEFT">full_name : varchar(150)</TD></TR><TR><TD ALIGN="LEFT">phone : varchar(16)</TD></TR><TR><TD ALIGN="LEFT">email : varchar(254)</TD></TR><TR><TD ALIGN="LEFT">username : varchar(150)</TD></TR></TABLE>>]; // Поля portal_user, прочитанные через PRAGMA.
portal_course [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dceee2"><B>portal_course</B></TD></TR><TR><TD ALIGN="LEFT">id : INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">title : varchar(200)</TD></TR></TABLE>>]; // Поля portal_course, прочитанные через PRAGMA.
portal_application [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dceee2"><B>portal_application</B></TD></TR><TR><TD ALIGN="LEFT">id : INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">start_date : date</TD></TR><TR><TD ALIGN="LEFT">payment_method : varchar(20)</TD></TR><TR><TD ALIGN="LEFT">review_text : TEXT</TD></TR><TR><TD ALIGN="LEFT">user_id : bigint FK</TD></TR><TR><TD ALIGN="LEFT">course_id : bigint FK</TD></TR><TR><TD ALIGN="LEFT">status : varchar(20)</TD></TR></TABLE>>]; // Поля portal_application, прочитанные через PRAGMA.
portal_user -> portal_application [label="1 : N (user_id)"]; // Одна запись родителя связана со многими заявками.
portal_course -> portal_application [label="1 : N (course_id)"]; // Одна запись родителя связана со многими заявками.
} // Завершаем ER-граф.
