# Локальная база содержит пользовательские данные и создаётся командой migrate.
db.sqlite3
# Тестовые SQLite-файлы и журнал не относятся к исходному коду.
*.sqlite3-*
# Байткод Python автоматически восстанавливается при запуске.
__pycache__/
# Виртуальное окружение создаём отдельно на каждом компьютере.
.venv/
# Локальные секреты нельзя коммитить в публичный репозиторий.
.env
# Отчёты UI-проверки генерируются локально и не входят в исходники.
ui-results/
# Случайный ключ этого компьютера не должен попадать в репозиторий.
.local_secret
