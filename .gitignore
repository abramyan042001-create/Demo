# Виртуальное окружение не относится к написанному коду.
.venv/
# База с пользователями и заявками создаётся локально.
db.sqlite3
# Секретный ключ одного компьютера нельзя публиковать.
.local_secret
# Байткод Python создаётся автоматически.
__pycache__/
# Временные журналы SQLite не включаем в историю.
*.sqlite3-*
